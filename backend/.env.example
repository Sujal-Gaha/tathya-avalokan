# ============================================================
# Tathya-Avalokan Backend — Environment Variables
# ============================================================
# Copy this file to `.env` and fill in your values:
#   cp .env.example .env
#
# NEVER commit your `.env` file to version control.
# ============================================================

# ------------------------------------------------------------
# REQUIRED: Fernet Symmetric Encryption Key
# ------------------------------------------------------------
# Used to encrypt database credentials at rest.
# Generate a fresh key with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
#
# ⚠️  WARNING: If this is missing or left as the default, the
# server will start with a deterministic DEVELOPMENT fallback
# key and emit a WARNING in the logs. NEVER deploy to
# production without setting a proper key. Rotating this key
# invalidates all previously stored encrypted credentials.
TATHYA_ENCRYPTION_KEY=

# ------------------------------------------------------------
# OPTIONAL: Internal Metadata Database URL
# ------------------------------------------------------------
# Defaults to a local SQLite file at `./app_metadata.db`.
# For a custom path or future PostgreSQL metadata store:
#   METADATA_DATABASE_URL=sqlite+aiosqlite:///./data/app_metadata.db
METADATA_DATABASE_URL=sqlite+aiosqlite:///./app_metadata.db

# ------------------------------------------------------------
# OPTIONAL: SQL Debug Logging
# ------------------------------------------------------------
# Set to "true" or "1" to echo all SQLAlchemy SQL statements.
# Useful during development; should be "false" in production.
SQL_DEBUG=false

# ------------------------------------------------------------
# OPTIONAL: CORS Allowed Origins
# ------------------------------------------------------------
# Comma-separated list of trusted frontend origins.
# Defaults to wildcard "*" (development only).
# Example: CORS_ORIGINS=http://localhost:5173,https://app.example.com
CORS_ORIGINS=*
