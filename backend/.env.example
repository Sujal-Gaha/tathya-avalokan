# ============================================================
# Tathya-Avalokan Backend — Environment Variables (Go)
# ============================================================
# Copy this file to `.env` and fill in your values:
#   cp .env.example .env
#
# NEVER commit your `.env` file to version control.
# ============================================================

# ------------------------------------------------------------
# HTTP Server Port
# ------------------------------------------------------------
PORT=8000

# ------------------------------------------------------------
# REQUIRED: AES-256-GCM Symmetric Encryption Key
# ------------------------------------------------------------
# Used to encrypt database credentials at rest.
# Generate a fresh 32-byte key or secret string:
#   openssl rand -base64 32
#
# ⚠️  WARNING: If this is missing or left empty, the server
# will start with a deterministic DEVELOPMENT fallback key and
# emit a WARNING in application logs. NEVER deploy to production
# without setting a secure random key.
TATHYA_ENCRYPTION_KEY=

# ------------------------------------------------------------
# Fallback Secret Key (Development Only)
# ------------------------------------------------------------
APP_SECRET_KEY=tathya-avalokan-default-dev-secret-key-32b

# ------------------------------------------------------------
# Internal Metadata Database URL / Path
# ------------------------------------------------------------
# Pure Go SQLite (modernc.org/sqlite) database file path.
# Defaults to `./app_metadata.db`.
METADATA_DATABASE_URL=./app_metadata.db

# ------------------------------------------------------------
# CORS Allowed Origins
# ------------------------------------------------------------
# Comma-separated list of trusted frontend origins.
# Defaults to wildcard "*" (development only).
# Example: CORS_ORIGINS=http://localhost:5173,http://localhost:3000
CORS_ORIGINS=*
